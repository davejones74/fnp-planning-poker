# Deployment-specific settings. Copy to .env (never commit .env).

# Azure Static Web Apps (Free plan) handles authentication via its built-in
# providers (GitHub / Entra ID / Google / X, etc.) — nothing to configure here.
# The Functions read the x-ms-client-principal header to build /api/me.
#
# Comma-separated authenticated identities allowed to administer the app
# (compared against the authenticated principal, e.g. email or oid).
ADMIN_USERS=

# Azure Web PubSub connection string (Free/F1 tier).
# Leave empty for the local in-memory prototype (no realtime persistence).
WEB_PUBSUB_CONNECTION_STRING=

# Web PubSub hub name all rooms connect through (set by azure-setup.ps1).
# Must be a lowercase alphanumeric identifier, e.g. fnp.
WEB_PUBSUB_HUB=fnp

# Hostname Azure assigns to the deployment (used to build absolute URLs,
# correct WebSocket origins behind Azure front ends).
WEBSITE_HOSTNAME=

# Cosmos DB connection string (Free tier, Table API) for durable rooms.
# Used from Phase 2; empty keeps the in-memory RoomRepository locally.
COSMOS_TABLE_CONNECTION_STRING=

# Room lifetime in hours. Rooms are kept in memory only (Phase 1) or in
# Cosmos DB (Phase 2) and expire after this long without activity.
ROOM_EXPIRY_HOURS=24

# Default estimation deck. One of the keys in shared/decks.ts:
#   fandp     -> XS, S, M, L, XL, XXL, ?, coffee (default)
#   fibonacci -> 0, 1, 2, 3, 5, 8, 13, 21, 34, 55, ?
DEFAULT_DECK=fandp

# Port for the local development server (not used by Azure Functions).
PORT=8080

# ── Jira import (file upload) ─────────────────────────────────────────────────
#
# Base site used to link imported issues: a story imported as PAY-9053 gets the
# link <JIRA_HOST>/browse/PAY-9053. Include the scheme (https://).
JIRA_HOST=https://hmcts.atlassian.net

# Project key prefix used to keep only issues from one project on import
# (e.g. PAY keeps PAY-123 and drops anything else). KEY is the short alias;
# JIRA_PROJECT_KEY wins when both are set.
KEY=PAY
JIRA_PROJECT_KEY=

# Export either the CSV ("Export CSV (all fields)") or the RSS/XML feed from the
# Jira filter, then upload the file in the "Import stories" dialog. Parsing is
# done in the browser — the file is never uploaded. The RSS *activity* feed lists
# comments, not issues, so CSV is the reliable choice.

# ── Jira import (live OAuth fetch — disabled until credentials are set) ────────
#
# The OAuth fetch path is implemented but disabled in the UI. Register an OAuth2
# app at https://developer.atlassian.com (Cloud -> OAuth 2.0 integrations ->
# Create OAuth2 integration) and paste the client id/secret here to enable it.
#
# JIRA_REDIRECT_URI must be an allowed callback URL of the app and match the URL
# the browser actually hits. Locally this is http://localhost:8080/api/jira/callback
# (the callback is served by this repo's own server). In Phase 2 the SWA/API host
# and its https:// URL apply instead.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:8080/api/jira/callback

# Optional base site used when a feed link has no recognizable site (unused today;
# the parser always reads the site from the pasted link).
JIRA_SITE=

# Set to 1 to bypass Atlassian entirely: /api/jira/authorize shows a mock consent
# page and /api/jira/feed returns canned stories. Lets the UI flow be tested
# without registering an OAuth app.
JIRA_MOCK=